{
  "name": "aicms-astro-head-spike",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "tokens": "node scripts/tokens.mjs",
    "dev": "npm run tokens && astro dev",
    "build": "npm run tokens && astro build",
    "start": "wrangler dev",
    "release": "node scripts/release.mjs",
    "rollback": "node scripts/release.mjs --rollback",
    "cf:staging": "npm run build && wrangler versions upload",
    "cf:publish": "wrangler versions deploy"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.12",
    "astro": "^7.4.10",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^14.4.8",
    "wrangler": "^4.160.0"
  }
}
